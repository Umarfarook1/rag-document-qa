# Copy to .env (gitignored) and fill in.
# Read by the answer-generation CLI; the retrieval pipeline does NOT require .env.
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR requires a User-Agent string identifying you (per their fair-use policy).
# Format: "Your Name your.email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: override default cache locations.
RAG_CORPUS_CACHE=./.cache/corpus
RAG_INDEX_CACHE=./.cache/index
